{
  "name": "sextant-drift-monorepo",
  "version": "2.0.0",
  "description": "SextantDrift — 架构 X 光机与偏航检测罗盘 (Architecture X-Ray & Drift Compass)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "start": "./start.sh",
    "build": "pnpm -r run build",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "bench": "pnpm --filter @sextant/core bench",
    "release": "./scripts/publish-to-npm.sh"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "@vitest/coverage-v8": "2.1.9",
    "@vitest/ui": "^2.1.9",
    "pnpm": "^9.15.0",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "keywords": [
    "architecture-x-ray",
    "drift-detection",
    "ast-analysis",
    "invariants",
    "mermaid"
  ],
  "author": "",
  "license": "MIT"
}
