{
  "$schema": "https://raw.githubusercontent.com/blacktea1526/SextantDriftV03/main/schemas/sextant.schema.json",
  "name": "SextantDrift",
  "version": "2.0.0",
  "description": "Architecture X-Ray & Drift Compass Monorepo Self-Dogfooding Specification",
  "systemContext": {
    "systemName": "SextantDrift",
    "description": "Architecture X-Ray & Drift Compass for continuous architecture verification",
    "actors": [
      {
        "id": "Architect",
        "name": "Human Architect & Tech Lead",
        "role": "human",
        "description": "Defines target architecture specifications and reviews drift reports"
      },
      {
        "id": "AIAgent",
        "name": "AI Coding Agent",
        "role": "agent",
        "description": "Writes code and performs pre-commit architecture drift checks"
      },
      {
        "id": "CIPipeline",
        "name": "CI/CD Gate Pipeline",
        "role": "system",
        "description": "Automated architectural conformance gatekeeper in GitHub Actions"
      }
    ],
    "externalSystems": [
      {
        "id": "GitRepo",
        "name": "Source Code & Git Repository",
        "description": "TypeScript AST files, git history, and architecture specifications"
      },
      {
        "id": "HTMLViewer",
        "name": "Offline Report Browser",
        "description": "Static HTML5 browser viewing platform for architecture reports"
      }
    ]
  },
  "containers": [
    {
      "id": "cli",
      "name": "CLI Presentation Tier",
      "order": 1,
      "technology": "Node.js / CAC / ANSI",
      "type": "application",
      "description": "Terminal entrypoint and CI gate controller"
    },
    {
      "id": "engine",
      "name": "Core Engine Tier",
      "order": 2,
      "technology": "TypeScript / Headless",
      "type": "service",
      "description": "Pure headless analysis, invariants and C4 diff engine"
    },
    {
      "id": "infrastructure",
      "name": "AST & Graph Infrastructure Tier",
      "order": 3,
      "technology": "TypeScript AST / Tarjan SCC",
      "type": "library",
      "description": "AST extraction and graph topology infrastructure"
    },
    {
      "id": "contracts",
      "name": "Types & Foundations Tier",
      "order": 4,
      "technology": "TypeScript Contract Types",
      "type": "library",
      "description": "Core architecture definitions and domain errors"
    }
  ],
  "layers": [
    {
      "id": "cli",
      "name": "CLI Presentation Layer",
      "order": 1
    },
    {
      "id": "engine",
      "name": "Core Engine & Parsing Layer",
      "order": 2
    },
    {
      "id": "infrastructure",
      "name": "AST & Graph Infrastructure Layer",
      "order": 3
    },
    {
      "id": "contracts",
      "name": "Types & Foundations Layer",
      "order": 4
    }
  ],
  "components": [
    {
      "id": "CliGate",
      "name": "CLI Gate & Commands",
      "layerId": "cli",
      "technology": "CAC / ANSI",
      "description": "CLI command dispatcher and quality gates",
      "paths": [
        "packages/cli/src/**"
      ]
    },
    {
      "id": "CoreFacade",
      "name": "Core Facade API",
      "layerId": "engine",
      "technology": "TypeScript API",
      "description": "Main entry point for architecture analysis",
      "paths": [
        "packages/core/src/index.ts"
      ]
    },
    {
      "id": "C4Engine",
      "name": "C4 Architecture Model Engine",
      "layerId": "engine",
      "technology": "TypeScript / C4 Model",
      "description": "C4 model topology extraction and diff graph builder",
      "paths": [
        "packages/core/src/c4/**"
      ]
    },
    {
      "id": "SpecParser",
      "name": "Spec & DSL Parser",
      "layerId": "engine",
      "paths": [
        "packages/core/src/parser/**"
      ]
    },
    {
      "id": "InvariantsEngine",
      "name": "Invariants Rule Engine",
      "layerId": "engine",
      "paths": [
        "packages/core/src/invariants/**"
      ]
    },
    {
      "id": "ComparatorEngine",
      "name": "Topology Comparator Engine",
      "layerId": "engine",
      "paths": [
        "packages/core/src/comparator/**"
      ]
    },
    {
      "id": "BaselineEngine",
      "name": "Baseline & Fingerprint Engine",
      "layerId": "engine",
      "paths": [
        "packages/core/src/baseline/**"
      ]
    },
    {
      "id": "StateEngine",
      "name": "State Machine Verifier Engine",
      "layerId": "engine",
      "paths": [
        "packages/core/src/state/**"
      ]
    },
    {
      "id": "TraceRecorder",
      "name": "Dynamic Trace Recorder",
      "layerId": "engine",
      "paths": [
        "packages/core/src/trace/**"
      ]
    },
    {
      "id": "CausalityEngine",
      "name": "Dynamic Causality Differencer",
      "layerId": "engine",
      "paths": [
        "packages/core/src/causality/**"
      ]
    },
    {
      "id": "ContractEngine",
      "name": "API Contract Alignment Engine",
      "layerId": "engine",
      "technology": "TypeScript / Markdown AST",
      "description": "API contract markdown specification parser, route AST extractor, and alignment verifier",
      "paths": [
        "packages/core/src/contract/**"
      ]
    },
    {
      "id": "AstAnalyzer",
      "name": "AST Extractor & Path Resolver",
      "layerId": "infrastructure",
      "paths": [
        "packages/core/src/analyzer/**"
      ]
    },
    {
      "id": "GraphAlgorithms",
      "name": "Directed Graph & Tarjan SCC",
      "layerId": "infrastructure",
      "paths": [
        "packages/core/src/graph/**"
      ]
    },
    {
      "id": "CoreContracts",
      "name": "Core Architecture & Report Types",
      "layerId": "contracts",
      "paths": [
        "packages/core/src/types/**"
      ]
    },
    {
      "id": "CoreErrors",
      "name": "Core Configuration Errors",
      "layerId": "contracts",
      "paths": [
        "packages/core/src/errors/**"
      ]
    }
  ],
  "allowDependencies": [
    {
      "from": "cli",
      "to": "engine"
    },
    {
      "from": "engine",
      "to": "infrastructure"
    },
    {
      "from": "engine",
      "to": "contracts"
    },
    {
      "from": "infrastructure",
      "to": "contracts"
    }
  ],
  "invariants": [
    {
      "id": "CORE_ZERO_CLI_DOM",
      "severity": "critical",
      "desc": "Core analysis engine must maintain 0 CLI and 0 DOM dependencies (戒律 3)",
      "pattern": {
        "forbid_import": [
          "cac",
          "picocolors",
          "commander",
          "chalk",
          "@sextant/cli",
          "sextant-drift",
          "@sextant/web-report"
        ],
        "in_path": "packages/core/src/**"
      }
    }
  ]
}
